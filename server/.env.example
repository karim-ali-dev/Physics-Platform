# بيانات الدخول للوحة تحكم المدرس (غيّرها فوراً من لوحة التحكم)
ADMIN_USERNAME=ahmedeldeeb
ADMIN_PASSWORD=Physics@2026

# بورت السيرفر
PORT=4000

# العنوان الأساسي للموقع (بيستخدم في روابط استعادة كلمة السر و OAuth)
# BASE_URL=http://localhost:4000

# ------------------ تسجيل الدخول الاجتماعي (Google) ------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ------------------ إرسال الإيميلات (نسيت كلمة السر) ------------------
# الطريقة 1: SMTP (مثلاً Brevo — ببريد مجاني 300 رسالة/يوم)
# افتح حساب في https://www.brevo.com -> SMTP & API -> سمّي مفتاح جديد وانسخه
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@email.com
#   SMTP_PASS=<مفتاح SMTP من Brevo>
#   SMTP_FROM=منصة الفيزياء <you@email.com>
#
# الطريقة 2: Resend (بدون SMTP) — ببريد مجاني 100 رسالة/يوم
# افتح حساب في https://resend.com -> API Keys -> أنشئ مفتاح
#   RESEND_API_KEY=re_xxxxxxxxxxxx
#   RESEND_FROM=onboarding@resend.dev   (أو دومينك بعد توثيقه)

# ------------------ مساعد الذكاء الاصطناعي (Gemini) ------------------
# اشتق مفتاح مجاني من https://aistudio.google.com/apikey عشان مساعد الفيزياء AI يشتغل
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
